FROM mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
ARG TELEGRAM_ARCHIVE_URL=https://github.com/telegramdesktop/tdesktop/releases/download/v7.3.5/td-setup-linux-x64-7.3.5.tar.xz
ARG TELEGRAM_ARCHIVE_SHA256=62082a56b212f22d75106dd13b7e3b9bc4ecdbfb472146b56c74da74199855b7
RUN apt-get update && apt-get upgrade -y \
    && apt-get purge -y gstreamer1.0-plugins-bad libgstreamer-plugins-bad1.0-0 \
    && apt-get install -y --no-install-recommends \
    ca-certificates curl xz-utils xvfb xdotool openbox ffmpeg \
    nftables util-linux acl libegl1 libgl1 libopengl0 libxkbcommon0 libxcb-cursor0 \
    libxcb-keysyms1 libxcb-icccm4 libxcb-image0 libxcb-render-util0 libxcb-xinerama0 \
    libxcb-randr0 libxcb-shape0 libxcb-xkb1 libasound2t64 libdbus-1-3 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN test ${#TELEGRAM_ARCHIVE_SHA256} -eq 64 \
    && curl --fail --location --retry 3 --max-time 180 --proto '=https' --proto-redir '=https' "$TELEGRAM_ARCHIVE_URL" -o /tmp/telegram.tar.xz \
    && echo "$TELEGRAM_ARCHIVE_SHA256  /tmp/telegram.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/telegram.tar.xz -C /opt \
    && rm /tmp/telegram.tar.xz
RUN useradd --uid 10001 --create-home recorder && mkdir /data /session /exports
WORKDIR /app
COPY deploy/build.lock /tmp/build.lock
COPY addons/capture/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/build.lock \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock \
    && pip uninstall -y pip setuptools virtualenv filelock distlib \
    && rm -rf /root/.cache /root/.local/share/virtualenv
RUN python -c 'from pathlib import Path; browsers=list(Path("/ms-playwright").glob("chromium-*/chrome-linux*/chrome")); assert len(browsers)==1, browsers; Path("/usr/bin/chromium").symlink_to(browsers[0])'
COPY tgwitness_capture /app/tgwitness_capture
COPY addons/capture/deploy/trusted-entrypoint.py /app/trusted-entrypoint.py
COPY addons/capture/deploy/trusted-display.py /app/trusted-display.py
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python", "/app/trusted-entrypoint.py"]
