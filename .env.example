# Optional host port for either Docker Compose installation.
TGWITNESS_PORT=8787

# Required only with compose.https.yaml. Use a hostname you control.
TGWITNESS_DOMAIN=watch.example.org

# Required only with compose.image.yaml, after the first successful GitHub release.
# Replace OWNER/REPOSITORY with the lowercase GitHub repository path.
TGWITNESS_IMAGE=ghcr.io/OWNER/REPOSITORY:0.6.1

# Optional independent witness (docker compose --profile witness up -d, or compose.witness.yaml).
# The token comes from the panel's Witness page; the bot must be an administrator of the channel.
#TGWITNESS_WITNESS_TOKEN=tgww_...
#TGWITNESS_WITNESS_BOT_TOKEN=123456:ABC...
#TGWITNESS_WITNESS_CHANNEL=@your_witness_channel
#TGWITNESS_WITNESS_INTERVAL=10
# Seconds to wait for the collector and the Bot API; what to post: all, changes or problems;
# the first words of every post.
#TGWITNESS_WITNESS_TIMEOUT=30
#TGWITNESS_WITNESS_POST=all
#TGWITNESS_WITNESS_TITLE=TgWitness witness
# Only for compose.witness.yaml, or another workspace: /profiles/<workspace ID> at the end.
#TGWITNESS_WITNESS_COLLECTOR=https://collector.example.org
#TGWITNESS_WITNESS_COLLECTOR_FINGERPRINT=REPLACE_WITH_COLLECTOR_FINGERPRINT
# Independent witness HTTP traffic; an MTProxy link cannot route Bot API requests.
#TGWITNESS_WITNESS_PROXY=socks5://proxy.example.org:1080
#TGWITNESS_WITNESS_BOT_API=https://api.telegram.org
# Native collector only; Docker uses compose.proxies.yaml and ./proxy-config/proxies.json.
#TGWITNESS_PROXY_CATALOG=/private/proxy-config/proxies.json
# Public-list refresh uses separate HTTPS requests, directly unless this HTTP/SOCKS5 proxy is set.
# The bundled list works without fetching. An operator catalog disables public-list downloads.
#TGWITNESS_PROXY_FEED_PROXY=socks5://proxy.example.org:1080
