{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tgwitness:board:status:v1",
  "additionalProperties": false,
  "properties": {
    "id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "card_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Card Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "review",
        "confirmed",
        "dismissed"
      ],
      "title": "State",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 20000,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "card_id",
    "state"
  ],
  "title": "Status",
  "type": "object"
}
