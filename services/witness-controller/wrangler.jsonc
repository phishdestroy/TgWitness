{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tgwitness-controller",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "RUNS", "class_name": "WitnessRun" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WitnessRun"] }]
}
