      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (label) (tgw_floodwait_remaining_seconds{label=~\"$account\"})",
          "legendFormat": "{{label}} left",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (label) (rate(tgw_floodwait_seconds_total{label=~\"$account\"}[5m]))",
          "legendFormat": "{{label}} wait/s",
